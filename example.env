# Port the HTTP server listens on
APP_PORT=3001

# PostgreSQL
DATABASE_DIALECT=postgres
DATABASE_NAME=arithmetic_calculator
DATABASE_USERNAME=fakevalue
DATABASE_PASSWORD=fakevalue
DATABASE_HOST=localhost
DATABASE_PORT=5432

# JWT signing. REQUIRED — the app refuses to start without it.
# Use a random string of at least 32 characters (e.g. `openssl rand -hex 32`).
JWT_SECRET=fakevalue
# Optional: previous secret, only to keep old tokens valid during a rotation.
# Leave empty in normal operation.
JWT_SECRET_PREVIOUS=
# Key id embedded in the token header (for future multi-key rotation).
JWT_KID=v1
# Token lifetime in seconds.
JWT_EXPIRATION_SECONDS=3600

# Comma-separated list of allowed origins for CORS, or * (dev only).
# Production example: CORS_ORIGIN=https://arithmetic-calculator-ui.onrender.com
CORS_ORIGIN=*

# Login rate limiting (per 15-minute window)
LOGIN_RATE_LIMIT_MAX=20
LOGIN_USERNAME_RATE_LIMIT_MAX=10
